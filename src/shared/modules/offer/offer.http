@baseUrl = http://localhost:4000
@userId = 6af5d86a471beea1b827cc87
@offerId = 6ad8e77e195e982b1658abec

# Получение списка всех предложений
GET {{baseUrl}}/offers HTTP/1.1

###

# Получение списка предложений с лимитом (например, 2 штуки)
GET {{baseUrl}}/offers?limit=2 HTTP/1.1

###

# Создание нового предложения об аренде (подставьте реальный @userId наверху)
POST {{baseUrl}}/offers HTTP/1.1
Content-Type: application/json

{
  "title": "Роскошные апартаменты в центре Парижа",
  "description": "Просторная светлая квартира с видом на Эйфелеву башню и свежим дизайнерским ремонтом.",
  "city": "Paris",
  "previewImage": "http://example.com/preview.jpg",
  "photosLinks": [
    "http://example.com/photo-1.jpg",
    "http://example.com/photo-2.jpg",
    "http://example.com/photo-3.jpg",
    "http://example.com/photo-4.jpg",
    "http://example.com/photo-5.jpg",
    "http://example.com/photo-6.jpg"
  ],
  "isPremium": true,
  "housingType": "apartment",
  "bedrooms": 3,
  "maxGuests": 5,
  "price": 3200,
  "amenities": [
    "Breakfast",
    "Air conditioning",
    "Laptop friendly workspace",
    "Towels"
  ],
  "location": {
    "latitude": 48.85661,
    "longitude": 2.351499
  },
  "userId": "{{userId}}"
}

###

# Получение детальной информации о предложении по ID
GET {{baseUrl}}/offers/{{offerId}} HTTP/1.1

###

# Редактирование предложения по ID
PATCH {{baseUrl}}/offers/{{offerId}} HTTP/1.1
Content-Type: application/json

{
  "title": "Обновленный заголовок квартиры в Париже",
  "price": 4500,
  "isPremium": false
}

###

# Получение премиальных предложений для города Paris
GET {{baseUrl}}/offers/premium/Paris HTTP/1.1

###

# Добавление предложения в избранное (status: 1)
POST {{baseUrl}}/offers/{{offerId}}/favorite HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}",
  "status": 1
}

###

# Получение списка избранных предложений пользователя
GET {{baseUrl}}/offers/favorites HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}"
}

###

# Удаление предложения из избранного (status: 0)
POST {{baseUrl}}/offers/{{offerId}}/favorite HTTP/1.1
Content-Type: application/json

{
  "userId": "{{userId}}",
  "status": 0
}

###

# Удаление предложения по ID (должен вернуть 204 No Content)
DELETE {{baseUrl}}/offers/{{offerId}} HTTP/1.1

###
