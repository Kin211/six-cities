@baseUrl = http://localhost:4000
@userId = 6af5d86a471beea1b827cc87

# Регистрация нового пользователя
POST {{baseUrl}}/users HTTP/1.1
Content-Type: application/json

{
  "name": "Иван Петров",
  "email": "ivan.petrov@example.com",
  "avatarPath": "img/avatar-1.jpg",
  "password": "password123",
  "userType": "pro"
}

###

# Попытка повторной регистрации с тем же email (должен вернуть 409 Conflict)
POST {{baseUrl}}/users HTTP/1.1
Content-Type: application/json

{
  "name": "Иван Дубль",
  "email": "ivan.petrov@example.com",
  "password": "password123",
  "userType": "regular"
}

###

# Авторизация пользователя (Вход)
POST {{baseUrl}}/users/login HTTP/1.1
Content-Type: application/json

{
  "email": "ivan.petrov@example.com",
  "password": "password123"
}

###

# Авторизация с несуществующим email (должен вернуть 401 Unauthorized)
POST {{baseUrl}}/users/login HTTP/1.1
Content-Type: application/json

{
  "email": "unknown@example.com",
  "password": "password123"
}

###

# Проверка состояния пользователя (Check Auth)
GET {{baseUrl}}/users/login HTTP/1.1

###

# Обновление аватара пользователя (подставьте реальный ID в @userId наверху)
POST {{baseUrl}}/users/{{userId}}/avatar HTTP/1.1
Content-Type: application/json

{
  "avatarPath": "img/new-super-avatar.png"
}

###
